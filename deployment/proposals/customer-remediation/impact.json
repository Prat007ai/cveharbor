  "delete_triggers": [
    {
      "name": "delete_asset_remediation",
      "table": "inventory_assets",
      "sql": "CREATE TRIGGER delete_asset_remediation BEFORE DELETE ON inventory_assets\nBEGIN DELETE FROM remediations WHERE user_id=OLD.user_id AND cve_id IN (SELECT record_id FROM remediation_finding_links WHERE user_id=OLD.user_id AND asset_id=OLD.id); END"
    },
    {
      "name": "review_assignment_revoked",
      "table": "remediation_assignment_requests",
      "sql": "CREATE TRIGGER review_assignment_revoked AFTER UPDATE OF revoked_at ON remediation_assignment_requests\nWHEN OLD.revoked_at IS NULL AND NEW.revoked_at IS NOT NULL\nBEGIN\n DELETE FROM remediation_review_sessions WHERE assignment_id=NEW.id;\n DELETE FROM remediation_review_challenges WHERE assignment_id=NEW.id;\n UPDATE remediation_review_notifications SET state='cancelled',completed_at=NEW.revoked_at WHERE assignment_id=NEW.id AND state='queued';\nEND"
    }
  ],
